# ========== Django ==========
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ========== Database (matches docker-compose.yml) ==========
DATABASE_URL=postgres://explore:explore@localhost:5432/explore_os

# ========== LLM: 阿里云百炼（DashScope 兼容模式）==========
# OpenAI 兼容端点（不要带尾斜杠）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# MVP（纯文本 TL;DR）默认用轻量快模型
LLM_MODEL_TEXT=deepseek-v4-flash
# 多模态（论文配图 + 文本深度解读，iter-003 用）
LLM_MODEL_MULTIMODAL=qwen3.6-plus

# 图像分类（便宜多模态，iter-003 每张图一次分类调用）
LLM_MODEL_VISION_CLASSIFIER=qwen-vl-plus
# 兼容老变量名：ft-006 读 LLM_MODEL 作为默认；设为文本模型即可
LLM_MODEL=deepseek-v4-flash

# 每日预算上限（元 CNY），触顶后解读降级到「直接透传 abstract 前 N 字」
LLM_DAILY_BUDGET_CNY=30

# ========== SMTP: 企业微信邮箱 (WeCom / exmail) ==========
# 面板：https://work.weixin.qq.com/ 或 https://exmail.qq.com/
# 登录邮箱后台 → 客户端设置 → 开启 SMTP/IMAP，生成「专用密码」
# （不是登录密码；账号后缀通常是 @你的域名）
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your-sender@yourdomain.com
EMAIL_HOST_PASSWORD=wecom-client-special-password
EMAIL_FROM=your-sender@yourdomain.com

# 默认收件箱（订阅 delivery 里可覆写）
EMAIL_TO_DEFAULT=your-inbox@yourdomain.com
